const categories=[
  {id:"all",label:"🌐 All"},
  {id:"chat",label:"💬 Chat"},
  {id:"image",label:"🎨 Image"},
  {id:"video",label:"🎬 Video"},
  {id:"code",label:"💻 Code"},
  {id:"voice",label:"🎵 Voice & Music"},
  {id:"search",label:"🔍 Search"},
  {id:"productivity",label:"⚡ Productivity"},
  {id:"writing",label:"✍️ Writing"},
  {id:"avatar",label:"🧑 Avatar & Fun"},
];
let cC='all',cS='';
function gCL(c){const x=categories.find(i=>i.id===c);return x?x.label.replace(/^[^\w\s]+\s*/,''):c}
function bC(){
  const w=document.getElementById('catButtons');
  w.innerHTML=categories.map((c,i)=>`<button class="cat-btn${i===0?' active':''}" onclick="fC('${c.id}',this)">${c.label}</button>`).join('');
  document.getElementById('catCount').textContent=categories.length-1;
}
function rG(){
  const g=document.getElementById('aiGrid'),n=document.getElementById('noResults'),f=document.getElementById('featured-section');
  let fl=tools.filter(t=>(cC==='all'||t.cat===cC)&&(t.name.toLowerCase().includes(cS.toLowerCase())||t.desc.toLowerCase().includes(cS.toLowerCase())));
  f.style.display=(cC==='all'&&!cS)?'block':'none';
  document.getElementById('totalCount').textContent=fl.length;
  document.getElementById('headerCount').textContent=tools.length;
  if(!fl.length){g.innerHTML='';n.style.display='block';return;}
  n.style.display='none';
  g.innerHTML=fl.map((t,i)=>`
    <div class="card" style="animation-delay:${Math.min(i,25)*.03}s" onclick="window.open('${t.link}','_blank')">
      <div class="card-header">
        <div class="card-icon">${t.icon}</div>
        <div class="card-badges">
          ${t.badge==='free'?'<span class="badge badge-free">Free</span>':''}
          ${t.badge==='paid'?'<span class="badge badge-paid">Paid</span>':''}
          ${t.badge==='new'?'<span class="badge badge-new">New</span>':''}
          ${t.badge==='hot'?'<span class="badge badge-hot">🔥 Hot</span>':''}
        </div>
      </div>
      <div class="card-name">${t.name}</div>
      <div class="card-category">${gCL(t.cat)}</div>
      <div class="card-desc">${t.desc}</div>
      <div class="card-footer">
        <div class="rating">⭐ ${t.rating}</div>
        <a href="${t.link}" target="_blank" class="open-btn" onclick="event.stopPropagation()">Open ↗</a>
      </div>
    </div>
  `).join('');
}
function fC(c,b){cC=c;document.querySelectorAll('.cat-btn').forEach(x=>x.classList.remove('active'));b.classList.add('active');rG();}
function filterCards(){cS=document.getElementById('searchInput').value;rG();}
let dP;
window.addEventListener('beforeinstallprompt',e=>{e.preventDefault();dP=e;document.getElementById('installBanner').style.display='flex';});
function installApp(){if(dP){dP.prompt();dP.userChoice.then(()=>{dP=null;document.getElementById('installBanner').style.display='none';});}}
if('serviceWorker' in navigator){navigator.serviceWorker.register('sw.js');}
document.addEventListener('contextmenu',e=>e.preventDefault());
document.addEventListener('keydown',e=>{if(e.ctrlKey&&(e.key==='u'||e.key==='s'))e.preventDefault();});
bC();rG();
</script>
